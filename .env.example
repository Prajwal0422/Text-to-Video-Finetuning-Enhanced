# NEXUS VISION - Environment Variables Example
# Copy this file to .env and fill in your values

# Pexels API Key (Optional but recommended)
# Get your free API key at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Video Generation Settings
DEFAULT_RESOLUTION=1080
DEFAULT_FPS=30
DEFAULT_DURATION=8

# Cache Settings
ENABLE_CACHE=true
CACHE_DIR=outputs/clips
MAX_CACHE_SIZE_GB=5

# Performance Settings
MAX_WORKERS=4
ENABLE_GPU=false

# Logging
LOG_LEVEL=INFO
