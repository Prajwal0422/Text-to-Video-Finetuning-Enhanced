# NEXUS VISION Environment Variables

# Pexels API Key (Optional but recommended)
# Get your free key at: https://www.pexels.com/api/
# Free tier: 200 requests/hour
PEXELS_API_KEY=your_pexels_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Video Settings
DEFAULT_CLIP_DURATION=3.0
VIDEO_RESOLUTION_HEIGHT=720
TRANSITION_DURATION=0.5

# Performance
MAX_WORKERS=2
CACHE_CLIPS=true
